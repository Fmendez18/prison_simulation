# DESIGN PATTERN 1: SINGLETON 

class EventLogger:
    _inst      = None
    _meta_lock = threading.Lock()

    def __new__(cls):
        if cls._inst is None:
            with cls._meta_lock:
                if cls._inst is None:
                    o = super().__new__(cls)
                    o._conn = sqlite3.connect(DB_PATH, check_same_thread=False)
                    o._lock = threading.Lock()
                    o._conn.executescript("""
                        CREATE TABLE IF NOT EXISTS events(
                            id INTEGER PRIMARY KEY, timestamp REAL,
                            inmate_id INTEGER, event_type TEXT,
                            location TEXT, outcome TEXT, duration_ms INTEGER);
                        CREATE TABLE IF NOT EXISTS capacity_snapshots(
                            id INTEGER PRIMARY KEY, timestamp REAL,
                            location TEXT, occupancy INTEGER, capacity INTEGER);
                        CREATE TABLE IF NOT EXISTS reputation_snapshots(
                            id INTEGER PRIMARY KEY, timestamp REAL,
                            inmate_id INTEGER, reputation REAL);
                    """)
                    o._conn.commit()
                    cls._inst = o
        return cls._inst

    def log(self, iid, etype, loc=None, outcome=None, ms=None):
        with self._lock:
            self._conn.execute(
                "INSERT INTO events(timestamp,inmate_id,event_type,location,outcome,duration_ms)"
                " VALUES(?,?,?,?,?,?)",
                (time.time(), iid, etype, loc, outcome, ms))
            self._conn.commit()

    def snap_capacity(self, all_locs):
        with self._lock:
            t = time.time()
            self._conn.executemany(
                "INSERT INTO capacity_snapshots(timestamp,location,occupancy,capacity)"
                " VALUES(?,?,?,?)",
                [(t, l.name, len(l.occupants), l.capacity) for l in all_locs])
            self._conn.commit()

    def snap_rep(self, all_inmates):
        with self._lock:
            t = time.time()
            self._conn.executemany(
                "INSERT INTO reputation_snapshots(timestamp,inmate_id,reputation)"
                " VALUES(?,?,?)",
                [(t, i.id, i.reputation) for i in all_inmates if i.alive])
            self._conn.commit()

    def query(self, sql):
        with self._lock:
            return self._conn.execute(sql).fetchall()

class Location:
    def __init__(self, name, capacity, gang_ctrl=None):
        self.name = name
        self.capacity = capacity
        self.occupants = []
        self.lock = threading.Lock()
        self.gang_ctrl = gang_ctrl


class Inmate:
    def __init__(self, id, name, ethnicity, reputation, sentence_days,
                 gang_id=None, inventory=None, alive=True, escaped=False,
                 debt=0, current_loc="cell_block", solitary_until=0.0,
                 recovery_until=0.0, state=None):
        self.id = id
        self.name = name
        self.ethnicity = ethnicity
        self.reputation = reputation
        self.sentence_days = sentence_days
        self.gang_id = gang_id
        self.inventory = inventory if inventory is not None else []
        self.alive = alive
        self.escaped = escaped
        self.debt = debt
        self.current_loc = current_loc
        self.solitary_until = solitary_until
        self.recovery_until = recovery_until
        self.state = state if state is not None else FreeState()
        self.inv_lock = threading.Lock()
        self.rep_lock = threading.Lock()

    def set_state(self, s):
        self.state = s


class Guard:
    def __init__(self, id, name, corrupt=False, bribed=False,
                 bribe_until=0.0, current_loc="cell_block"):
        self.id = id
        self.name = name
        self.corrupt = corrupt
        self.bribed = bribed
        self.bribe_until = bribe_until
        self.current_loc = current_loc


class Gang:
    def __init__(self, id, name, ethnicity, treasury=0):
        self.id = id
        self.name = name
        self.ethnicity = ethnicity
        self.members = []
        self.treasury = treasury
        self.lock = threading.Lock()

